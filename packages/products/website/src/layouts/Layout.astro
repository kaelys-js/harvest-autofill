---
import "@/styles/global.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const site = Astro.site?.href.replace(/\/$/, "") ?? "https://kaelys-js.github.io";
const canonical = `${site}${base}/`;
const title = "Harvest Auto-Fill — your timesheet fills itself";
const description =
	"A macOS menu-bar app that fills your Harvest timesheet from the work you already did — commits, pushes, and meetings turned into hours, filed for you every Friday. Private, open source, nothing to install.";
const ogImage = `${site}${base}/og.png`;

// GitHub Pages can't set real HTTP response headers, so we set what's possible via <meta>.
const csp = [
	"default-src 'self'",
	"img-src 'self' data:",
	"style-src 'self' 'unsafe-inline'",
	"script-src 'self' 'unsafe-inline'",
	"connect-src 'self' https://api.github.com",
	"font-src 'self'",
	"base-uri 'self'",
	"form-action 'self'",
	"frame-ancestors 'none'",
].join("; ");
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta http-equiv="Content-Security-Policy" content={csp} />
		<meta name="referrer" content="strict-origin-when-cross-origin" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Cole Beuker" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonical} />
		<link rel="sitemap" href={`${base}/sitemap-index.xml`} />

		<!-- Icons -->
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
		<link rel="icon" href={`${base}/favicon-32.png`} sizes="32x32" type="image/png" />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<link rel="manifest" href={`${base}/manifest.webmanifest`} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Harvest Auto-Fill" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Harvest Auto-Fill — your timesheet fills itself" />
		<meta property="og:locale" content="en_US" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content="Harvest Auto-Fill — your timesheet fills itself" />

		<!-- Set theme before paint to avoid a flash -->
		<script is:inline>
			const t = localStorage.getItem("theme");
			if (t === "dark" || (!t && matchMedia("(prefers-color-scheme: dark)").matches))
				document.documentElement.classList.add("dark");
		</script>
	</head>
	<body class="min-h-screen antialiased">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground"
			>Skip to content</a
		>
		<slot />
	</body>
</html>
