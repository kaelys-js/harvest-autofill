---
import "@/styles/global.css";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const title = "Harvest Auto-Fill — your timesheet fills itself";
const description =
  "A macOS menu-bar app that fills your Harvest timesheet from the work you already did — commits, pushes, and meetings turned into hours, filed for you every Friday. Private, open source, nothing to install.";
const ogImage = `${base}/screens/whatsnew.png`;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#e8622c" />
    <!-- set theme before paint to avoid a flash -->
    <script is:inline>
      const t = localStorage.getItem("theme");
      if (t === "dark" || (!t && matchMedia("(prefers-color-scheme: dark)").matches))
        document.documentElement.classList.add("dark");
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <slot />
  </body>
</html>
