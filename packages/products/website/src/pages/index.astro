---
import Layout from "@/layouts/Layout.astro";
import WindowMockup from "@/components/WindowMockup.astro";
import OnboardingCarousel from "@/components/OnboardingCarousel.tsx";
import PreferencesMockup from "@/components/PreferencesMockup.tsx";
import WhatsNewMockup from "@/components/WhatsNewMockup.astro";
import GithubMark from "@/components/GithubMark.astro";
import ThemeToggle from "@/components/ThemeToggle.tsx";
import DownloadButton from "@/components/DownloadButton.tsx";
import Faq from "@/components/Faq.tsx";
import { faqItems } from "@/data/faq";
import * as v from "valibot";
import { FeaturesSchema, HowItWorksStepsSchema, parseBasePath, parseUrl } from "@/lib/schemas";
import { Card, CardTitle, CardDescription } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import {
	CalendarCheck,
	GitCommitHorizontal,
	ShieldCheck,
	PackageCheck,
	RefreshCw,
	ChartPie,
	Sparkles,
	Lock,
	Cloud,
	PlugZap,
} from "lucide-react";

const base: string = parseBasePath(import.meta.env.BASE_URL.replace(/\/$/, ""));
const REPO: string = parseUrl("https://github.com/kaelys-js/harvest-autofill-releases");
const ZIP: string = parseUrl(`${REPO}/releases/latest/download/HarvestAutoFill.zip`);

const features = [
	{
		icon: CalendarCheck,
		title: "Files itself every Friday",
		body: "Your finished week lands in Harvest automatically at 6pm, even if the app is closed. It never double-books, so you can forget it's there.",
	},
	{
		icon: GitCommitHorizontal,
		title: "Built from real work",
		body: "Your commits, pushes, and meetings become hours on a timeline, credited to the project you were actually on.",
	},
	{
		icon: ChartPie,
		title: "Split across projects",
		body: "The time between things is credited to the right project, so each one shows real hours instead of a commit count.",
	},
	{
		icon: PackageCheck,
		title: "Nothing to install",
		body: "Everything it needs is already inside. Connect your accounts in a quick guided setup and you're done.",
	},
	{
		icon: RefreshCw,
		title: "Keeps itself current",
		body: "It checks for a new version, installs it for you, and shows a plain-language note about what changed.",
	},
	{
		icon: ShieldCheck,
		title: "Private by design",
		body: "Everything stays on your Mac in a spot only the app can read. No account, no cloud, no tracking — and the source is open.",
	},
];

const steps = [
	{
		n: "1",
		title: "Connect your accounts",
		body: "A guided onboarding pulls in your Harvest, GitHub, Azure DevOps, and calendar — with a live test so nothing breaks later.",
	},
	{
		n: "2",
		title: "It watches your week",
		body: "The menu-bar total recomputes in the background, turning your real work into a per-project, per-day breakdown.",
	},
	{
		n: "3",
		title: "Friday, it files",
		body: "At 6pm the finished week is written to Harvest automatically. Or click “Log this week” whenever you like.",
	},
];

// Fail the build on a malformed edit (blank copy, dropped icon). Parsed for the throw; the
// typed literals above stay the source the template renders.
v.parse(FeaturesSchema, features);
v.parse(HowItWorksStepsSchema, steps);
---

<Layout faq={faqItems}>
	<!-- backdrop -->
	<div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
		<div
			class="absolute -top-40 left-1/2 h-[36rem] w-[72rem] -translate-x-1/2 rounded-full bg-primary/10 blur-3xl"
		>
		</div>
		<div
			class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,var(--color-border)_1px,transparent_0)] [background-size:26px_26px] opacity-40"
		>
		</div>
	</div>

	<!-- nav -->
	<header class="sticky top-0 z-40 border-b border-border/60 bg-background/70 backdrop-blur-xl">
		<nav aria-label="Main" class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-5">
			<a
				href="#main"
				class="flex items-center gap-2.5 font-semibold"
				aria-label="Harvest Auto-Fill, home"
			>
				<span
					class="grid size-8 place-items-center rounded-lg bg-gradient-to-br from-[#f6903a] to-[#e2541f] text-white"
				>
					<svg
						viewBox="0 0 24 24"
						class="size-5"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						aria-hidden="true"
						><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg
					>
				</span>
				Harvest Auto-Fill
			</a>
			<div class="ml-auto hidden items-center gap-7 text-sm text-muted-foreground md:flex">
				<a href="#features" class="transition-colors hover:text-foreground">Features</a>
				<a href="#how" class="transition-colors hover:text-foreground">How it works</a>
				<a href="#faq" class="transition-colors hover:text-foreground">FAQ</a>
			</div>
			<div class="ml-auto flex items-center gap-2 md:ml-6">
				<a
					href={REPO}
					target="_blank"
					rel="noopener noreferrer"
					class="grid size-9 place-items-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
					aria-label="View on GitHub (opens in a new tab)"><GithubMark class="size-5" /></a
				>
				<ThemeToggle client:load />
				<span class="hidden sm:block"><DownloadButton client:load size="default" /></span>
			</div>
		</nav>
	</header>

	<main id="main">
		<!-- hero -->
		<section class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-16 md:py-24 lg:grid-cols-2">
			<!-- Hero entrance: the LCP headline animates transform-only (data-hero="lcp",
			     never opacity:0) so LCP stays fast; the rest fade+rise with a light stagger. -->
			<div>
				<span data-hero class="inline-block">
					<Badge className="border-primary/20 bg-primary/10 text-primary"
						><Sparkles className="size-3.5" /> Open source · macOS 26</Badge
					>
				</span>
				<h1
					data-hero="lcp"
					class="mt-5 text-4xl font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl"
				>
					Your timesheet <span
						class="bg-gradient-to-r from-[#f2762a] to-[#e2541f] bg-clip-text text-transparent"
						>fills itself.</span
					>
				</h1>
				<p
					data-hero
					style="--hd:120ms"
					class="mt-5 max-w-xl text-lg text-muted-foreground text-pretty"
				>
					Harvest Auto-Fill turns the work you already did — commits, pushes, and meetings — into
					hours, split across the right projects and filed for you every Friday.
				</p>
				<div data-hero style="--hd:200ms" class="mt-8 flex flex-wrap items-center gap-3">
					<DownloadButton client:load />
					<a href={REPO} target="_blank" rel="noopener noreferrer"
						><span
							class="inline-flex h-11 items-center gap-2 rounded-md border border-border bg-background px-6 text-base font-medium shadow-xs transition-colors hover:bg-accent"
							><GithubMark class="size-4" /> View on GitHub<span class="sr-only">
								(opens in a new tab)</span
							></span
						></a
					>
				</div>
				<p data-hero style="--hd:260ms" class="mt-4 text-sm text-muted-foreground">
					Free · Apple Silicon · nothing to install
				</p>
			</div>
			<div data-hero style="--hd:140ms" class="flex justify-center lg:justify-end">
				<WindowMockup />
			</div>
		</section>

		<!-- trust bar -->
		<section id="trust" class="border-y border-border/60 bg-muted/30">
			<div
				class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-10 gap-y-4 px-5 py-6 text-sm text-muted-foreground"
			>
				<span class="inline-flex items-center gap-2"
					><Lock className="size-4 text-primary" /> Your data stays on your Mac</span
				>
				<span class="inline-flex items-center gap-2"
					><Cloud className="size-4 text-primary" /> No account, no cloud</span
				>
				<span class="inline-flex items-center gap-2"
					><GithubMark class="size-4 text-primary" /> Fully open source</span
				>
				<span class="inline-flex items-center gap-2"
					><PlugZap className="size-4 text-primary" /> Nothing to install</span
				>
			</div>
		</section>

		<!-- features -->
		<section id="features" class="mx-auto max-w-6xl px-5 py-20">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="text-3xl font-bold tracking-tight sm:text-4xl" data-reveal>
					Everything, handled
				</h2>
				<p class="mt-3 text-muted-foreground">
					The tedious parts of timesheets, done for you — accurately.
				</p>
			</div>
			<div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
				{
					features.map((f) => (
						<Card className="gap-3 transition-shadow hover:shadow-md">
							<div class="grid size-10 place-items-center rounded-lg bg-primary/10 text-primary">
								<f.icon className="size-5" />
							</div>
							<CardTitle>{f.title}</CardTitle>
							<CardDescription className="leading-relaxed">{f.body}</CardDescription>
						</Card>
					))
				}
			</div>
		</section>

		<!-- how it works -->
		<section id="how" class="border-y border-border/60 bg-muted/30">
			<div class="mx-auto max-w-6xl px-5 py-20">
				<div class="mx-auto max-w-2xl text-center">
					<h2 class="text-3xl font-bold tracking-tight sm:text-4xl" data-reveal>Set it up once</h2>
					<p class="mt-3 text-muted-foreground">Two minutes of setup, then it runs on its own.</p>
				</div>
				<div class="mt-12 grid gap-8 md:grid-cols-3" data-stagger>
					{
						steps.map((s) => (
							<div class="relative">
								<div class="grid size-10 place-items-center rounded-full bg-primary text-lg font-bold text-primary-foreground">
									{s.n}
								</div>
								<h3 class="mt-4 text-lg font-semibold">{s.title}</h3>
								<p class="mt-2 text-muted-foreground">{s.body}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- screenshots -->
		<section id="native" class="mx-auto max-w-6xl px-5 py-20">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="text-3xl font-bold tracking-tight sm:text-4xl" data-reveal>
					Made to feel native
				</h2>
				<p class="mt-3 text-muted-foreground">
					A setup you can step through, every preference tab, and a changelog after each update.
				</p>
			</div>
			<div class="mt-12 grid items-start justify-items-center gap-8 md:grid-cols-2 lg:grid-cols-3">
				<figure class="w-full" data-reveal>
					<OnboardingCarousel client:visible />
					<figcaption class="mt-3 text-center text-sm text-muted-foreground">
						Step through all six setup screens.
					</figcaption>
				</figure>
				<figure class="w-full" data-reveal>
					<PreferencesMockup client:visible />
					<figcaption class="mt-3 text-center text-sm text-muted-foreground">
						Every preference tab, one click away.
					</figcaption>
				</figure>
				<figure class="w-full" data-reveal>
					<WhatsNewMockup />
					<figcaption class="mt-3 text-center text-sm text-muted-foreground">
						A plain-language changelog after every update.
					</figcaption>
				</figure>
			</div>
		</section>

		<!-- download -->
		<section id="download" class="border-y border-border/60 bg-muted/30">
			<div class="mx-auto max-w-3xl px-5 py-20 text-center">
				<h2 class="text-3xl font-bold tracking-tight sm:text-4xl" data-reveal>
					Get Harvest Auto-Fill
				</h2>
				<p class="mt-3 text-muted-foreground">
					macOS 26 or newer, Apple Silicon. Free and open source.
				</p>
				<div class="mt-8 flex justify-center"><DownloadButton client:visible /></div>
				<ol class="mx-auto mt-10 max-w-xl space-y-4 text-left">
					<li class="flex items-start gap-4">
						<span
							class="grid size-8 shrink-0 place-items-center rounded-full bg-primary/10 text-sm font-semibold text-primary tabular-nums"
							>1</span
						>
						<p class="pt-1 text-sm text-muted-foreground">
							Unzip and drag <span class="font-medium text-foreground">Harvest Auto-Fill</span> to your
							Applications folder.
						</p>
					</li>
					<li class="flex items-start gap-4">
						<span
							class="grid size-8 shrink-0 place-items-center rounded-full bg-primary/10 text-sm font-semibold text-primary tabular-nums"
							>2</span
						>
						<p class="pt-1 text-sm text-muted-foreground">
							Right-click the app and choose <span class="font-medium text-foreground">Open</span> the
							first time. macOS asks once, then remembers it.
						</p>
					</li>
					<li class="flex items-start gap-4">
						<span
							class="grid size-8 shrink-0 place-items-center rounded-full bg-primary/10 text-sm font-semibold text-primary tabular-nums"
							>3</span
						>
						<p class="pt-1 text-sm text-muted-foreground">
							A guided wizard walks you through connecting your accounts, then it lives in your menu
							bar.
						</p>
					</li>
				</ol>
			</div>
		</section>

		<!-- faq -->
		<section id="faq" class="mx-auto max-w-3xl px-5 py-20">
			<div class="text-center">
				<h2 class="text-3xl font-bold tracking-tight sm:text-4xl" data-reveal>Questions</h2>
			</div>
			<div class="mt-10"><Faq client:visible /></div>
			<div
				class="mt-12 flex flex-col items-center gap-4 rounded-2xl border border-border/60 bg-card p-8 text-center"
			>
				<h3 class="text-xl font-semibold">Ready to stop filling timesheets?</h3>
				<DownloadButton client:visible />
			</div>
		</section>
	</main>

	<footer class="border-t border-border/60 bg-muted/20">
		<div class="mx-auto max-w-6xl px-5 py-14">
			<div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
				<div class="max-w-sm lg:col-span-2">
					<div class="flex items-center gap-2.5 font-semibold">
						<span
							class="grid size-8 place-items-center rounded-lg bg-gradient-to-br from-[#f6903a] to-[#e2541f] text-white"
						>
							<svg
								viewBox="0 0 24 24"
								class="size-5"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								aria-hidden="true"
								><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg
							>
						</span>
						Harvest Auto-Fill
					</div>
					<p class="mt-4 text-sm leading-relaxed text-muted-foreground">
						Your macOS timesheet, filled from the work you already did. Private, open source, and
						free.
					</p>
					<div class="mt-6"><DownloadButton client:visible size="default" /></div>
				</div>

				<nav aria-label="Product">
					<h2 class="text-sm font-semibold">Product</h2>
					<ul class="mt-4 space-y-3 text-sm text-muted-foreground">
						<li>
							<a href="#features" class="transition-colors hover:text-foreground">Features</a>
						</li>
						<li><a href="#how" class="transition-colors hover:text-foreground">How it works</a></li>
						<li>
							<a href="#download" class="transition-colors hover:text-foreground">Download</a>
						</li>
						<li><a href="#faq" class="transition-colors hover:text-foreground">FAQ</a></li>
					</ul>
				</nav>

				<nav aria-label="Resources">
					<h2 class="text-sm font-semibold">Resources</h2>
					<ul class="mt-4 space-y-3 text-sm text-muted-foreground">
						<li>
							<a
								href={REPO}
								target="_blank"
								rel="noopener noreferrer"
								class="transition-colors hover:text-foreground"
								>Source on GitHub<span class="sr-only"> (opens in a new tab)</span></a
							>
						</li>
						<li>
							<a
								href={`${REPO}/releases`}
								target="_blank"
								rel="noopener noreferrer"
								class="transition-colors hover:text-foreground"
								>Releases<span class="sr-only"> (opens in a new tab)</span></a
							>
						</li>
						<li>
							<a
								href={`${REPO}/releases/latest`}
								target="_blank"
								rel="noopener noreferrer"
								class="transition-colors hover:text-foreground"
								>Changelog<span class="sr-only"> (opens in a new tab)</span></a
							>
						</li>
						<li>
							<a
								href={`${REPO}/blob/main/LICENSE`}
								target="_blank"
								rel="noopener noreferrer"
								class="transition-colors hover:text-foreground"
								>MIT License<span class="sr-only"> (opens in a new tab)</span></a
							>
						</li>
					</ul>
				</nav>
			</div>

			<div
				class="mt-12 flex flex-col items-center justify-between gap-3 border-t border-border/60 pt-6 text-xs text-muted-foreground sm:flex-row"
			>
				<span>© 2026 Harvest Auto-Fill · Released under the MIT License.</span>
				<span>Not affiliated with or endorsed by Harvest.</span>
			</div>
		</div>
	</footer>
</Layout>
