---
// Recreation of the app's six-step first-run wizard — no client data, no framework. All six slides stack
// in one grid cell (the frame is the tallest step's height, so it never jumps); the active one
// is opaque and interactive, the rest sit a nudge to either side at opacity 0 and cross-fade in
// when selected. A few lines of vanilla JS drive it: it auto-advances only while on screen (an
// IntersectionObserver gate), pauses on hover/focus, and honours reduced-motion. Icons are
// lucide's own paths inlined (stroke 1.8, white in the orange badge).
import * as v from "valibot";
import { OnboardingStepsSchema } from "@/lib/schemas";

type Step = { title: string; body: string; icon: string };

const STEPS: Step[] = [
	{
		title: "Welcome to Harvest Auto-Fill",
		body: "Your timesheet, filled from the work you already did.",
		icon: '<circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path>',
	},
	{
		title: "Connect your Harvest account",
		body: "The only account it needs — Harvest is where your hours land.",
		icon: '<path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"></path><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle>',
	},
	{
		title: "Find your projects automatically",
		body: "It reads your Harvest projects and fills in the details, so you never type them by hand.",
		icon: '<path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle>',
	},
	{
		title: "Where your work lives",
		body: "Pick what turns into hours. GitHub is the main one; the rest are optional.",
		icon: '<rect width="8" height="8" x="3" y="3" rx="2"></rect><path d="M7 11v4a2 2 0 0 0 2 2h4"></path><rect width="8" height="8" x="13" y="13" rx="2"></rect>',
	},
	{
		title: "Your workday",
		body: "Sensible defaults are already set — tweak them only if yours differ.",
		icon: '<path d="M16 14v2.2l1.6 1"></path><path d="M16 2v3"></path><path d="M21 7.338V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2h2.338"></path><path d="M3 9h5.859"></path><path d="M8 2v3"></path><circle cx="16" cy="16" r="6"></circle>',
	},
	{
		title: "Here's your week",
		body: "A live preview from everything you connected. Nothing is logged until you confirm.",
		icon: '<path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"></path><path d="m16 9-5.5 5.5L8 12"></path>',
	},
];

// Build-time guard: every slide needs copy and an icon.
v.parse(OnboardingStepsSchema, STEPS);
---

<div
	data-onb-carousel
	class="w-full max-w-md overflow-hidden rounded-2xl border border-border/60 bg-card shadow-2xl shadow-black/10 ring-1 ring-black/5 dark:shadow-black/40"
>
	<div class="flex items-center gap-2 border-b border-border/60 px-4 py-3">
		<span class="size-3 rounded-full bg-[#ff5f57]"></span>
		<span class="size-3 rounded-full bg-[#febc2e]"></span>
		<span class="size-3 rounded-full bg-[#28c840]"></span>
		<span class="ml-2 text-xs font-medium text-muted-foreground">Harvest Auto-Fill — Setup</span>
		<span class="ml-auto text-xs tabular-nums text-muted-foreground" data-onb-step>
			Step 1 of {STEPS.length}
		</span>
	</div>

	<div data-onb-track aria-live="polite">
		{
			STEPS.map((s, n) => (
				<div
					data-onb-slide={n}
					data-active={n === 0 ? "" : undefined}
					inert={n !== 0}
					class="flex items-start gap-4 px-7 py-8"
				>
					<div class="grid size-14 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-[#f6903a] to-[#e2541f] shadow-md">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="24"
							height="24"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="size-8 text-white"
							aria-hidden="true"
							set:html={s.icon}
						/>
					</div>
					<div>
						<h3 class="text-xl font-bold tracking-tight">{s.title}</h3>
						<p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{s.body}</p>
					</div>
				</div>
			))
		}
	</div>

	<div class="flex items-center justify-between border-t border-border/60 px-5 py-4">
		<button
			type="button"
			class="rounded-md px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-muted"
			data-onb-back
			aria-label="Previous step"
		>
			Back
		</button>
		<div class="flex gap-2" role="tablist" aria-label="Onboarding steps">
			{
				STEPS.map((s, n) => (
					<button
						type="button"
						role="tab"
						aria-selected={n === 0}
						aria-label={`Step ${n + 1}: ${s.title}`}
						data-onb-dot={n}
						class="group grid size-6 place-items-center rounded-full"
					>
						{/* 24px hit area (WCAG 2.2 target-size); the visible pip stays small. */}
						<span
							data-onb-pip
							class:list={[
								"size-2 rounded-full transition-all",
								n === 0 ? "w-5 bg-primary" : "bg-border group-hover:bg-muted-foreground/40",
							]}
						/>
					</button>
				))
			}
		</div>
		<button
			type="button"
			class="rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90"
			data-onb-next
			aria-label="Next step"
		>
			Continue
		</button>
	</div>
</div>

<script>
	const AUTO_MS = 5000;
	for (const root of document.querySelectorAll<HTMLElement>("[data-onb-carousel]")) {
		const slides = [...root.querySelectorAll<HTMLElement>("[data-onb-slide]")];
		const dots = [...root.querySelectorAll<HTMLElement>("[data-onb-dot]")];
		const stepLabel = root.querySelector<HTMLElement>("[data-onb-step]");
		const next = root.querySelector<HTMLElement>("[data-onb-next]");
		const back = root.querySelector<HTMLElement>("[data-onb-back]");
		const N = slides.length;
		if (!N || !next || !back) continue;
		const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
		let i = 0;
		let paused = false;
		let inView = false;
		let timer: ReturnType<typeof setTimeout> | undefined;

		const render = () => {
			slides.forEach((s, n) => {
				const on = n === i;
				s.toggleAttribute("data-active", on);
				s.inert = !on;
				// steps before the active one sit to its left, steps after sit to its right, so the
				// incoming step always slides in from the side it "comes from".
				s.style.setProperty("--onb-dir", n < i ? "-1" : "1");
			});
			dots.forEach((d, n) => {
				const on = n === i;
				d.setAttribute("aria-selected", String(on));
				// The visible pip lives inside the 24px hit-area button; toggle its state, not the button's.
				const pip = d.querySelector<HTMLElement>("[data-onb-pip]");
				pip?.classList.toggle("w-5", on);
				pip?.classList.toggle("bg-primary", on);
				pip?.classList.toggle("bg-border", !on);
				pip?.classList.toggle("group-hover:bg-muted-foreground/40", !on);
			});
			if (stepLabel) stepLabel.textContent = `Step ${i + 1} of ${N}`;
			next.textContent = i === N - 1 ? "Done" : "Continue";
		};
		const schedule = () => {
			if (timer) clearTimeout(timer);
			// Only auto-advance while the mockup is on screen, not paused, and motion is allowed.
			if (inView && !paused && !reduced) timer = setTimeout(() => go(i + 1), AUTO_MS);
		};
		const go = (n: number) => {
			i = (n + N) % N;
			render();
			schedule();
		};

		dots.forEach((d, n) => d.addEventListener("click", () => go(n)));
		back.addEventListener("click", () => go(i - 1));
		next.addEventListener("click", () => go(i + 1));
		const pause = () => {
			paused = true;
			if (timer) clearTimeout(timer);
		};
		const resume = () => {
			paused = false;
			schedule();
		};
		root.addEventListener("mouseenter", pause);
		root.addEventListener("mouseleave", resume);
		root.addEventListener("focusin", pause);
		root.addEventListener("focusout", resume);

		// Don't start the auto-advance until the carousel scrolls into view, and stop it when it
		// leaves — a mockup nobody's looking at shouldn't be cycling.
		const io = new IntersectionObserver(
			(entries) => {
				inView = entries[0].isIntersecting;
				if (inView) schedule();
				else if (timer) clearTimeout(timer);
			},
			{ threshold: 0.4 },
		);
		io.observe(root);
	}
</script>
