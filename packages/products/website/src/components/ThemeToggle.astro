---
// The theme toggle is a plain server-rendered button — no framework, so it adds no JS to the
// initial (above-the-fold) load. Both icons ship in the markup and CSS shows the right one for
// the current theme, so there's no hydration flash the way a client-state swap would have.
import { buttonVariants } from "@/components/ui/button";
---

<button
	type="button"
	data-theme-toggle
	class={buttonVariants({ variant: "ghost", size: "icon" })}
	aria-label="Toggle dark mode"
>
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		class="lucide lucide-moon dark:hidden"
		aria-hidden="true"
	>
		<path
			d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"
		></path>
	</svg>
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		class="lucide lucide-sun hidden dark:block"
		aria-hidden="true"
	>
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2"></path>
		<path d="M12 20v2"></path>
		<path d="m4.93 4.93 1.41 1.41"></path>
		<path d="m17.66 17.66 1.41 1.41"></path>
		<path d="M2 12h2"></path>
		<path d="M20 12h2"></path>
		<path d="m6.34 17.66-1.41 1.41"></path>
		<path d="m19.07 4.93-1.41 1.41"></path>
	</svg>
</button>

<script>
	import { toggleTheme } from "@/lib/theme";
	document.querySelector("[data-theme-toggle]")?.addEventListener("click", toggleTheme);
</script>
