---
// The FAQ accordion, framework-free. Native <details>/<summary> gives the same expand/collapse
// (and keyboard behaviour) the Radix version did, with zero JS. Classes mirror the old
// ui/accordion output so the closed rows and the open panel render pixel-for-pixel the same.
import { faqItems } from "@/data/faq";
---

<div class="w-full">
	{
		faqItems.map((it) => (
			<details class="group border-b last:border-b-0">
				<summary class="flex flex-1 list-none items-center justify-between gap-4 py-4 text-left text-base font-medium transition-all hover:underline cursor-pointer [&::-webkit-details-marker]:hidden">
					{it.q}
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="lucide lucide-chevron-down text-muted-foreground size-5 shrink-0 transition-transform duration-200 group-open:rotate-180"
						aria-hidden="true"
					>
						<path d="m6 9 6 6 6-6" />
					</svg>
				</summary>
				<div class="text-muted-foreground pb-4 pt-0 text-[0.95rem]">{it.a}</div>
			</details>
		))
	}
</div>
