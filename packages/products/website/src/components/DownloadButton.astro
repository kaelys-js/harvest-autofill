---
// A plain server-rendered download link — no framework, so the primary CTA adds no JS to the
// initial load. The version tag beside "Download for macOS" is baked in at build time from the
// release tag (PUBLIC_APP_VERSION); the site ships in lockstep with the app, so there's no need
// to fetch the latest release from GitHub at runtime. Empty on an untagged build (dev/E2E),
// with its width already reserved so nothing reflows.
import { buttonVariants } from "@/components/ui/button-variants";
import { parseDownloadSize, parseVersion, type DownloadSize } from "@/lib/schemas";
import { DOWNLOAD_ZIP } from "@/lib/download";

interface Props {
	size?: DownloadSize;
}
const { size = "lg" } = Astro.props;
const btnSize = parseDownloadSize(size);
const version = parseVersion(import.meta.env.PUBLIC_APP_VERSION) ?? "";
---

<a href={DOWNLOAD_ZIP} rel="noopener noreferrer" class="inline-block">
	<button type="button" class={buttonVariants({ size: btnSize })}>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			width="24"
			height="24"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			class="lucide lucide-download"
			aria-hidden="true"
		>
			<path d="M12 15V3"></path>
			<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
			<path d="m7 10 5 5 5-5"></path>
		</svg>
		<span>Download for macOS</span>
		<span class="inline-block min-w-[5.5ch] text-left font-normal tabular-nums opacity-80"
			>{version ? `· v${version}` : ""}</span
		>
	</button>
</a>
